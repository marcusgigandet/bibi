with "config/bibi_config.gpr";
with "ra4m1_hal";
project Bibi is

   Board := external ("BOARD", "uno_r4_minima");

   for Target use "arm-eabi";
   for Runtime ("Ada") use "light-cortex-m4";
   for Languages use ("Ada", "Asm");

   for Source_Dirs use (
                        "src/",
                        "boards/" & Board & "/config",
                        "boards/" & Board & "/linker",
                        "boards/" & Board & "/startup",
                        "config/"
                       );
   for Object_Dir use "obj/" & Bibi_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("bibi.adb");

   package Naming is
      for Body_Suffix ("Asm") use ".S";
   end Naming;

   package Compiler is
      for Default_Switches ("Ada") use
        Bibi_Config.Ada_Compiler_Switches &
      ("-mcpu=cortex-m4", "-mthumb", "-mfloat-abi=soft");
      for Default_Switches ("Asm") use
        ("-mcpu=cortex-m4", "-mthumb", "-mfloat-abi=soft");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use
        ("-L", Bibi'Project_Dir & "boards/" & Board & "/linker",
         "-T", Bibi'Project_Dir & "boards/" & Board & "/linker/linker.ld",
         "-nostartfiles", "-Wl,-N", "-Wl,--gc-sections",
         "-Wl,-z,noexecstack",
         "-Wl,-Map=" & Bibi'Project_Dir & "bin/bibi.map");
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Bibi;
